<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="@PREFIX@">
    <file preprocess="xml-stripblanks">@APP_ID@.metainfo.xml</file>
    <file preprocess="xml-stripblanks" alias="gtk/details-dialog.ui">details-dialog.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/fita-wizard.ui">fita-wizard.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/game.ui">game.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/integrations.ui">integrations.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/logo-picker.ui">logo-picker.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/preferences.ui">preferences.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/image-picker.ui">image-picker.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/wallpaper-picker.ui">wallpaper-picker.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/window.ui">window.ui</file>
    <file preprocess="xml-stripblanks" alias="shortcuts-dialog.ui">shortcuts-dialog.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/uzdoom-mods-dialog.ui">uzdoom-mods-dialog.ui</file>
    <file alias="style.css">gtk/style.css</file>
    <!-- Paletas de tema (cartridges/themes/catalog.py); preenchidas pelo Meson. -->
@theme_files@    <!-- Previews SVG opcionais (lane de UI); o registro tolera o diretório vazio. -->
@theme_previews@
    <file>library_placeholder.svg</file>
    <file>library_placeholder_small.svg</file>
    <!-- Logo Better-XCloud (branco sobre transparente) usado no card do
         Xbox Cloud Gaming. Fonte:
         https://github.com/redphx/better-xcloud/blob/typescript/resources/logos/better-xcloud-transparent.png -->
    <file>xbox-cloud.png</file>
    <file alias="alternatives/jolven-portal.svg">icons/alternatives/jolven-portal.svg</file>
  </gresource>
  <gresource prefix="@PREFIX@/icons/scalable/categories/">
  <file alias="bottles-source-symbolic.svg">icons/sources/bottles-source-symbolic.svg</file>
  <file alias="desktop-source-symbolic.svg">icons/sources/desktop-source-symbolic.svg</file>
  <file alias="dolphin-source-symbolic.svg">icons/sources/dolphin-source-symbolic.svg</file>
  <file alias="flatpak-source-symbolic.svg">icons/sources/flatpak-source-symbolic.svg</file>
  <file alias="heroic-source-symbolic.svg">icons/sources/heroic-source-symbolic.svg</file>
  <file alias="itch-source-symbolic.svg">icons/sources/itch-source-symbolic.svg</file>
  <file alias="legendary-source-symbolic.svg">icons/sources/legendary-source-symbolic.svg</file>
  <file alias="lutris-source-symbolic.svg">icons/sources/lutris-source-symbolic.svg</file>
  <file alias="retroarch-source-symbolic.svg">icons/sources/retroarch-source-symbolic.svg</file>
  <file alias="steam-source-symbolic.svg">icons/sources/steam-source-symbolic.svg</file>
  <file alias="twintail-source-symbolic.svg">icons/sources/twintail-source-symbolic.svg</file>
  <file alias="waydroid-source-symbolic.svg">icons/sources/waydroid-source-symbolic.svg</file>
  <file alias="yuzu-source-symbolic.svg">icons/sources/yuzu-source-symbolic.svg</file>
  <file alias="eden-source-symbolic.svg">icons/sources/eden-source-symbolic.svg</file>
  <file alias="uzdoom-source-symbolic.svg">icons/sources/uzdoom-source-symbolic.svg</file>
  <file alias="quiver-source-symbolic.svg">icons/sources/quiver-source-symbolic.svg</file>
  <file alias="xbox-cloud-symbolic.svg">icons/sources/xbox-cloud-symbolic.svg</file>
  </gresource>
  <gresource prefix="@PREFIX@/icons/scalable/actions/">
  <file alias="novidades-symbolic.svg">icons/actions/novidades-symbolic.svg</file>
  <file alias="trofeu-symbolic.svg">icons/actions/trofeu-symbolic.svg</file>
  </gresource>
</gresources>
