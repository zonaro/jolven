using Gtk 4.0;
using Adw 1;

template $DetailsDialog: Adw.Dialog {
  content-width: 480;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        action-name: "window.close";
      }

      [end]
      Button apply_button {
        styles [
          "suggested-action"
        ]
      }
    }

    Adw.PreferencesPage {
      Adw.PreferencesGroup install_notice_group {
        visible: false;

        Adw.ActionRow install_notice_row {
          title: _("Not Installed");
          subtitle: _("Launching this game from the library will install it.");
        }
      }

      Adw.PreferencesGroup cover_group {
        Adw.Clamp cover_clamp {
          maximum-size: 200;

          Overlay {
            [overlay]
            Adw.Spinner spinner {
              visible: false;
            }

            Overlay cover_overlay {
              halign: center;
              valign: center;

              [overlay]
              Button cover_button_edit {
                icon-name: "document-edit-symbolic";
                tooltip-text: _("New Cover");
                halign: end;
                valign: end;
                margin-bottom: 6;
                margin-end: 6;

                styles [
                  "circular",
                  "osd"
                ]
              }

              [overlay]
              Button cover_button_browse {
                icon-name: "edit-find-symbolic";
                tooltip-text: _("Buscar capa (SteamGridDB, IGDB, TheGamesDB, Wallhaven)");
                halign: start;
                valign: end;
                margin-bottom: 6;
                margin-start: 6;

                styles [
                  "circular",
                  "osd"
                ]
              }

              [overlay]
              Revealer cover_button_delete_revealer {
                transition-type: crossfade;
                margin-end: 40;

                Button cover_button_delete {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Delete Cover");
                  halign: end;
                  valign: end;
                  margin-bottom: 6;
                  margin-end: 6;

                  styles [
                    "circular",
                    "osd"
                  ]
                }
              }

              Picture cover {
                width-request: 200;
                height-request: 300;

                styles [
                  "card"
                ]
              }
            }
          }
        }
      }

      Adw.PreferencesGroup {
        Adw.ActionRow logo_row {
          title: _("Logo");
          activatable-widget: logo_button_browse;

          [suffix]
          Button logo_button_reset {
            valign: center;
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Voltar a escolher o logo automaticamente");
            visible: false;

            styles [
              "flat",
            ]
          }

          [suffix]
          Button logo_button_browse {
            valign: center;
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Escolher logo no SteamGridDB");

            styles [
              "flat",
            ]
          }

          [suffix]
          Button logo_button_file {
            valign: center;
            icon-name: "document-open-symbolic";
            tooltip-text: _("Escolher logo de um arquivo");

            styles [
              "flat",
            ]
          }
        }

        Adw.ActionRow wallpaper_row {
          title: _("Papel de parede da sessão");
          activatable-widget: wallpaper_button_browse;

          [suffix]
          Button wallpaper_button_reset {
            valign: center;
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Voltar a escolher o papel de parede automaticamente");
            visible: false;

            styles [
              "flat",
            ]
          }

          [suffix]
          Button wallpaper_button_browse {
            valign: center;
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Escolher papel de parede no wallhaven");

            styles [
              "flat",
            ]
          }

          [suffix]
          Button wallpaper_button_file {
            valign: center;
            icon-name: "document-open-symbolic";
            tooltip-text: _("Escolher papel de parede de um arquivo");

            styles [
              "flat",
            ]
          }
        }

        Adw.ActionRow fundo_row {
          title: _("Fundo da biblioteca");
          activatable-widget: fundo_button_browse;

          [suffix]
          Button fundo_button_reset {
            valign: center;
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Voltar a escolher o fundo automaticamente");
            visible: false;

            styles [
              "flat",
            ]
          }

          [suffix]
          Button fundo_button_browse {
            valign: center;
            icon-name: "edit-find-symbolic";
            tooltip-text: _("Escolher fundo (SteamGridDB, IGDB, TheGamesDB, Wallhaven)");

            styles [
              "flat",
            ]
          }

          [suffix]
          Button fundo_button_file {
            valign: center;
            icon-name: "document-open-symbolic";
            tooltip-text: _("Escolher fundo de um arquivo");

            styles [
              "flat",
            ]
          }
        }

        Adw.ActionRow fita_row {
          title: _("Iluminação inteligente");
          activatable-widget: fita_cor_menu;

          [suffix]
          Button fita_button_reset {
            valign: center;
            icon-name: "edit-undo-symbolic";
            tooltip-text: _("Voltar a escolher a cor a partir da capa");
            visible: false;

            styles [
              "flat",
            ]
          }

          [suffix]
          MenuButton fita_cor_menu {
            valign: center;
            tooltip-text: _("Escolher a cor da iluminação inteligente");

            child: DrawingArea fita_amostra {
              content-width: 22;
              content-height: 22;
            };

            popover: Popover {
              child: ColorChooserWidget fita_color_button {
                use-alpha: false;
              };
            };
          }
        }

        Adw.SpinRow fita_brilho_row {
          title: _("Brilho (%)");

          adjustment: Adjustment {
            lower: 1;
            upper: 100;
            step-increment: 1;
            page-increment: 10;
          };
        }
      }

      Adw.PreferencesGroup {
        Adw.EntryRow name {
          title: _("Title");
        }

        Adw.EntryRow developer {
          title: _("Developer (optional)");
        }

        Adw.EntryRow publisher {
          title: _("Publicadora (opcional)");
        }

        Adw.EntryRow release_date {
          title: _("Data de lançamento (opcional)");
        }

        Adw.EntryRow genre {
          title: _("Gênero (opcional)");
        }

        Adw.ComboRow controller_support {
          title: _("Compatibilidade com controle");

          model: StringList {
            strings [
              _("Não informada"),
              _("Total"),
              _("Parcial"),
            ]
          };
        }
      }

      Adw.PreferencesGroup {
        Adw.ComboRow status {
          title: _("Status");
        }

        Adw.ActionRow rating_row {
          title: _("Minha nota");
          subtitle: _("Clique na nota para removê-la");

          [suffix]
          Box rating_box {
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup executable_group {
        Adw.EntryRow executable {
          title: _("Executable");

          [suffix]
          Button file_chooser_button {
            valign: center;
            icon-name: "document-open-symbolic";
            tooltip-text: _("Select File");

            styles [
              "flat",
            ]
          }

          [suffix]
          MenuButton exec_info_button {
            valign: center;
            icon-name: "help-about-symbolic";
            tooltip-text: _("More Info");

            popover: Popover exec_info_popover {
              focusable: true;

              Label exec_info_label {
                use-markup: true;
                wrap: true;
                max-width-chars: 50;
                halign: center;
                valign: center;
                margin-top: 6;
                margin-bottom: 6;
                margin-start: 6;
                margin-end: 6;
              }
            };

            styles [
              "flat"
            ]
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Game profile");
        description: _("Overrides used only when launching this game.");

        Adw.ComboRow profile_gamemode {
          title: _("GameMode");
          model: StringList {
            strings [_("Use global setting"), _("Enabled"), _("Disabled")]
          };
        }

        Adw.ComboRow profile_mangohud {
          title: _("MangoHud");
          model: StringList {
            strings [_("Use global setting"), _("Enabled"), _("Disabled")]
          };
        }

        Adw.EntryRow profile_working_directory {
          title: _("Working directory");
        }

        Adw.SwitchRow profile_track_process {
          title: _("Track a specific process");
          subtitle: _("Useful for launchers that hand off to another executable");
        }

        Adw.EntryRow profile_process_executable {
          title: _("Process executable name");
          sensitive: bind profile_track_process.active;
        }

        Adw.SwitchRow profile_auto_record {
          title: _("Gravar automaticamente ao iniciar");
          subtitle: _("Requer o gravador ativo nas preferências. Não se aplica ao Xbox Cloud Gaming.");
        }

        Adw.EntryRow profile_environment {
          title: _("Environment (JSON)");
        }

        Adw.EntryRow profile_gamescope_options {
          title: _("Gamescope options");
        }

        Adw.SpinRow profile_fps_limit {
          title: _("FPS limit (0 = disabled)");
          adjustment: Adjustment {
            lower: 0;
            upper: 360;
            step-increment: 1;
            page-increment: 10;
          };
        }

        Adw.EntryRow profile_resolution {
          title: _("Resolution (for example 1920x1080)");
        }

        Adw.ComboRow profile_scaling {
          title: _("Scaling mode");
          model: StringList {
            strings [_("Default"), _("Auto"), _("Integer"), _("Fit"), _("Fill"), _("Stretch")]
          };
        }
      }

      Adw.PreferencesGroup updates_group {
        Adw.SwitchRow track_updates_switch {
          title: _("Notificar sobre atualizações");
          subtitle: _("Avisa quando houver atualização disponível");
        }
      }
    }
  }
}
