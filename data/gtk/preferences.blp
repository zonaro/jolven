using Gtk 4.0;
using Adw 1;

template $CartridgesPreferences: Adw.PreferencesDialog {
  search-enabled: true;

  Adw.PreferencesPage general_page {
    name: "general";
    title: _("General");
    icon-name: "user-home-symbolic";

    Adw.PreferencesGroup behavior_group {
      title: _("Behavior");

      Adw.SwitchRow exit_after_launch_switch {
        title: _("Exit After Launching Games");
      }

      Adw.SwitchRow cover_launches_game_switch {
        title: _("Cover Image Launches Game");
        subtitle: _("Swaps the behavior of the cover image and the play button");
      }

      Adw.SwitchRow agrupar_duplicados_switch {
        title: _("Agrupar jogos duplicados");
        subtitle: _("Mostra num card só o mesmo jogo de fontes diferentes");
      }

      Adw.SwitchRow playtime_tracking_switch {
        title: _("Contar horas de jogo");
        subtitle: _("Registra o tempo de cada sessão");
      }

      Adw.ComboRow language_row {
        title: _("Language");
        subtitle: _("Restart Jolven to apply the new language");
      }
    }

    Adw.PreferencesGroup atalho_global_group {
      title: _("Atalho global");

      Adw.ActionRow atalho_global_row {
        title: _("Abrir com Super+G");
        subtitle: _("Verificando…");
        activatable-widget: atalho_global_button;

        [suffix]
        Button atalho_global_button {
          label: _("Ativar");
          valign: center;

          styles [
            "suggested-action"
          ]
        }
      }
    }

    Adw.PreferencesGroup images_group {
      title: _("Images");

      Adw.SwitchRow high_quality_images_switch {
        title: _("High Quality Images");
        subtitle: _("Save game covers losslessly at the cost of storage");
      }
    }

    Adw.PreferencesGroup appearance_group {
      title: _("Aparência");

      Adw.ComboRow app_icon_row {
        title: _("Ícone do aplicativo");
        subtitle: _("Troca o ícone no menu e na grade. Pode ser preciso sair e entrar de novo para ver a mudança.");
      }
    }

    Adw.PreferencesGroup cloud_gaming_group {
      title: _("Cloud Gaming");

      Adw.SwitchRow xbox_cloud_gaming_switch {
        title: _("Xbox Cloud Gaming");
        subtitle: _("Mostra o card do Xbox Cloud Gaming junto aos launchers");
      }

      Adw.ActionRow xcloud_account_row {
        title: _("Conta Xbox");
        subtitle: _("Não conectado");
        sensitive: bind xbox_cloud_gaming_switch.active;
        activatable-widget: xcloud_login_button;

        [suffix]
        Button xcloud_login_button {
          valign: center;
          label: _("Entrar");
        }
      }

      Adw.SwitchRow xcloud_fullscreen_on_start_switch {
        title: _("Tela cheia");
        subtitle: _("Abre a transmissão em tela cheia");
        sensitive: bind xbox_cloud_gaming_switch.active;
      }
    }

  }

  Adw.PreferencesPage sunshine_page {
    name: "sunshine";
    title: _("Sunshine");
    icon-name: "network-workgroup-symbolic";

    Adw.PreferencesGroup sunshine_group {
      title: _("Exportar jogos");

      Adw.SwitchRow sunshine_auto_sync_switch {
        title: _("Adicionar jogos ao Sunshine automaticamente");
        subtitle: _("Novos jogos entram no apps.json do Sunshine, exceto Xbox Cloud");
      }

      Adw.EntryRow sunshine_apps_path_row {
        title: _("Arquivo apps.json (vazio usa o padrão)");
        sensitive: bind sunshine_auto_sync_switch.active;
      }

      Adw.ActionRow sunshine_sync_all_row {
        title: _("Sincronizar biblioteca");
        subtitle: _("Exporta todos os jogos atuais para o Sunshine");
        activatable-widget: sunshine_sync_all_button;

        [suffix]
        Button sunshine_sync_all_button {
          valign: center;
          label: _("Sincronizar agora");
        }
      }
    }

    Adw.PreferencesGroup sunshine_connection_group {
      title: _("Conexão com o Sunshine");

      Adw.EntryRow sunshine_host_row {
        title: _("Endereço");
      }

      Adw.EntryRow sunshine_port_row {
        title: _("Porta");
      }

      Adw.EntryRow sunshine_username_row {
        title: _("Usuário");
      }

      Adw.EntryRow sunshine_password_row {
        title: _("Senha (só nesta sessão)");
      }

      Adw.ActionRow sunshine_status_row {
        title: _("Estado");
        subtitle: _("Não verificado");
        activatable-widget: sunshine_test_button;

        [suffix]
        Button sunshine_test_button {
          valign: center;
          label: _("Testar");
        }
      }

      Adw.ActionRow sunshine_web_row {
        title: _("Abrir a Web UI do Sunshine");
        activatable-widget: sunshine_web_button;

        [suffix]
        Button sunshine_web_button {
          valign: center;
          label: _("Abrir");
        }
      }

      Adw.ActionRow sunshine_start_row {
        title: _("Iniciar o Sunshine");
        subtitle: _("Inicia o servidor em segundo plano");
        activatable-widget: sunshine_start_button;

        [suffix]
        Button sunshine_start_button {
          valign: center;
          label: _("Iniciar");
        }
      }
    }

    Adw.PreferencesGroup sunshine_apps_group {
      title: _("Apps no Sunshine");
      description: _("Atualizada ao testar a conexão");

      Adw.ActionRow sunshine_api_sync_row {
        title: _("Exportar biblioteca via API");
        subtitle: _("Cria os jogos no Sunshine com capa");
        activatable-widget: sunshine_api_sync_button;

        [suffix]
        Button sunshine_api_sync_button {
          valign: center;
          label: _("Exportar");
        }
      }
    }

    Adw.PreferencesGroup sunshine_host_config_group {
      title: _("Ajustes do host");
      description: _("Aplicar grava a config inteira e pede reinício");

      Adw.EntryRow sunshine_max_bitrate_row {
        title: _("Bitrate máximo (Kbps, 0 = auto)");
      }

      Adw.EntryRow sunshine_min_fps_row {
        title: _("FPS mínimo (0 = auto)");
      }

      Adw.SwitchRow sunshine_upnp_switch {
        title: _("UPnP");
        subtitle: _("Abrir portas para a internet");
      }

      Adw.EntryRow sunshine_origin_row {
        title: _("Web UI permitida (pc, lan ou wan)");
      }

      Adw.EntryRow sunshine_encoder_row {
        title: _("Codificador (auto, nvenc, vaapi, software…)");
      }

      Adw.ActionRow sunshine_apply_row {
        title: _("Aplicar ajustes");
        activatable-widget: sunshine_apply_button;

        [suffix]
        Button sunshine_apply_button {
          valign: center;
          label: _("Aplicar");
        }
      }
    }

    Adw.PreferencesGroup sunshine_pairings_group {
      title: _("Pareamentos");
      description: _("Pedidos do Moonlight aguardando PIN");
    }

    Adw.PreferencesGroup sunshine_clients_group {
      title: _("Clientes pareados");

      Adw.ActionRow sunshine_unpair_all_row {
        title: _("Desemparelhar todos");
        activatable-widget: sunshine_unpair_all_button;

        [suffix]
        Button sunshine_unpair_all_button {
          valign: center;
          label: _("Remover");
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Backup da sua biblioteca");
      description: _("Salve em um arquivo .zip a biblioteca completa e todas as configurações. A restauração substitui a biblioteca e as configurações atuais pelas do backup.");
      separate-rows: true;

      Adw.ButtonRow export_backup_button_row {
        title: _("Exportar para arquivo");
      }

      Adw.ButtonRow import_backup_button_row {
        title: _("Importar de arquivo");
      }
    }

    Adw.PreferencesGroup danger_zone_group {
      title: _("Danger Zone");
      separate-rows: true;

      Adw.ButtonRow remove_all_games_button_row {
        title: _("Remove All Games");

        styles [
          "destructive-action"
        ]
      }

      Adw.ButtonRow reset_button_row {
        visible: false;
        title: _("Reset App");

        styles [
          "destructive-action"
        ]
      }
    }
  }

  Adw.PreferencesPage recorder_page {
    name: "recorder";
    title: _("Gravacao");
    icon-name: "media-record-symbolic";

    Adw.PreferencesGroup recorder_source_group {
      title: _("Fonte");

      Adw.SwitchRow recorder_enabled_switch {
        title: _("Ativar o gravador");
        subtitle: _("Controla a gravação pela sessão do Jolven");
      }

      Adw.ComboRow recorder_source_row {
        title: _("Fonte de vídeo");
        subtitle: _("De onde a tela é capturada");
        sensitive: bind recorder_enabled_switch.active;
      }

      Adw.EntryRow recorder_output_dir_row {
        title: _("Pasta de saída");
        sensitive: bind recorder_enabled_switch.active;
      }
    }

    Adw.PreferencesGroup recorder_quality_group {
      title: _("Qualidade");
      sensitive: bind recorder_enabled_switch.active;

      Adw.ComboRow recorder_container_row {
        title: _("Formato do arquivo");
      }

      Adw.ComboRow recorder_codec_row {
        title: _("Codec de vídeo");
      }

      Adw.ComboRow recorder_quality_row {
        title: _("Qualidade");
      }

      Adw.ComboRow recorder_bitrate_mode_row {
        title: _("Modo de bitrate");
      }

      Adw.SpinRow recorder_fps_row {
        title: _("FPS");

        adjustment: Adjustment {
          lower: 1;
          upper: 240;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.SwitchRow recorder_cursor_switch {
        title: _("Gravar o cursor do mouse");
      }

      Adw.EntryRow recorder_scale_row {
        title: _("Resolução (ex.: 1920x1080, vazio = original)");
      }
    }

    Adw.PreferencesGroup recorder_audio_group {
      title: _("Áudio");
      sensitive: bind recorder_enabled_switch.active;

      Adw.ComboRow recorder_audio_row {
        title: _("Fonte de áudio");
      }

      Adw.ComboRow recorder_audio_codec_row {
        title: _("Codec de áudio");
      }

      Adw.SpinRow recorder_audio_bitrate_row {
        title: _("Bitrate de áudio (kbps)");

        adjustment: Adjustment {
          lower: 32;
          upper: 512;
          step-increment: 32;
          page-increment: 64;
        };
      }
    }

    Adw.PreferencesGroup recorder_replay_group {
      title: _("Replay");
      sensitive: bind recorder_enabled_switch.active;

      Adw.SpinRow recorder_replay_seconds_row {
        title: _("Duração do replay (segundos, 0 desliga)");

        adjustment: Adjustment {
          lower: 0;
          upper: 600;
          step-increment: 5;
          page-increment: 30;
        };
      }

      Adw.ComboRow recorder_replay_storage_row {
        title: _("Armazenamento do replay");
      }
    }

    Adw.PreferencesGroup recorder_stream_group {
      title: _("Streaming");
      sensitive: bind recorder_enabled_switch.active;

      Adw.EntryRow recorder_stream_url_row {
        title: _("URL de transmissão (RTMP, SRT ou WHIP)");
      }
    }
  }

  Adw.PreferencesPage session_page {
    name: "session";
    title: _("Sessão");
    icon-name: "video-joined-displays-symbolic";

    Adw.PreferencesGroup game_mode_group {
      title: _("Jolven Session");
      description: _("Settings used by the dedicated Gamescope session and game launches.");

      Adw.SwitchRow game_mode_use_gamemode_switch {
        title: _("Enable GameMode for games");
        subtitle: _("Uses gamemoderun when it is installed");
      }

      Adw.SwitchRow game_mode_use_mangohud_switch {
        title: _("Enable MangoHud for games");
        subtitle: _("Optional; ignored when MangoHud is not installed");
      }

      Adw.SwitchRow game_mode_enable_fps_limiter_switch {
        title: _("Enable Gamescope FPS limiter");
      }

      Adw.SwitchRow game_mode_enable_vrr_switch {
        title: _("Enable VRR when supported");
      }

      Adw.SwitchRow game_mode_start_library_switch {
        title: _("Start in Library");
      }

      Adw.SwitchRow game_mode_hide_mouse_cursor_switch {
        title: _("Hide mouse cursor when using a controller");
      }

      Adw.ComboRow game_overlay_button_row {
        title: _("Open the in-game overlay with");
        subtitle: _("Choose which controller system button opens Jolven while a game is running");
      }
    }

    Adw.PreferencesGroup game_mode_devices_group {
      title: _("Session devices");
      description: _("Leave blank to use the system default. Gamescope expects a DRM connector such as HDMI-A-1 or DP-1.");

      Adw.ComboRow game_mode_monitor_entry_row {
        title: _("Monitor connector");
      }

      Adw.ComboRow game_mode_audio_output_entry_row {
        title: _("Audio output");
      }

      Adw.ComboRow game_mode_audio_input_entry_row {
        title: _("Audio input");
      }
    }

    Adw.PreferencesGroup {
      title: _("Barra superior");

      Adw.SwitchRow show_news_button_switch {
        title: _("Mostrar o botão Novidades");
      }
    }

    Adw.PreferencesGroup session_wallpaper_group {
      title: _("Papel de parede");
      sensitive: bind playtime_tracking_switch.active;
      description: _("Durante a sessão, substitui temporariamente o papel de parede dos outros monitores por uma imagem relacionada ao jogo. A chave libera Sketchy e NSFW nos filtros da escolha.");

      Adw.SwitchRow session_wallpaper_switch {
        title: _("Trocar o papel de parede dos outros monitores");
      }

      Adw.EntryRow wallhaven_key_entry_row {
        title: _("Chave da API do wallhaven (opcional)");
        sensitive: bind session_wallpaper_switch.active;
      }

      Adw.ActionRow wallpaper_restore_row {
        title: _("Restaurar o papel de parede anterior");
        subtitle: _("Devolve o papel de parede de antes da sessão");
        activatable-widget: wallpaper_restore_button;

        [suffix]
        Button wallpaper_restore_button {
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Restaurar agora");

          styles [
            "flat"
          ]
        }
      }
    }

    Adw.PreferencesGroup session_fita_group {
      title: _("Iluminação inteligente");
      description: _("Muda a cor da iluminação inteligente enquanto o Jolven está aberto: a cor do aplicativo fora do jogo e a cor do jogo durante a sessão. Ao fechar o aplicativo, a iluminação inteligente volta ao estado anterior.");

      Adw.SwitchRow session_fita_switch {
        title: _("Mudar a cor da iluminação inteligente");
      }

      Adw.SpinRow fita_brilho_row {
        title: _("Brilho (%)");
        subtitle: _("Aplicado aos jogos sem brilho próprio definido");
        sensitive: bind session_fita_switch.active;

        adjustment: Adjustment {
          lower: 1;
          upper: 100;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.ActionRow fita_brilho_individual_row {
        title: _("Brilho máximo por dispositivo");
        subtitle: _("Define o brilho máximo de cada dispositivo");
        sensitive: bind session_fita_switch.active;
        activatable-widget: fita_brilho_individual_button;

        [suffix]
        Button fita_brilho_individual_button {
          valign: center;
          icon-name: "go-next-symbolic";
          tooltip-text: _("Ajustar o brilho de cada dispositivo");

          styles [
            "flat"
          ]
        }
      }

      Adw.ActionRow fita_cor_app_row {
        title: _("Cor do app");
        subtitle: _("A cor da iluminação inteligente com o aplicativo aberto e nenhum jogo em execução");
        sensitive: bind session_fita_switch.active;
        activatable-widget: fita_cor_app_menu;

        [suffix]
        Button fita_cor_app_reset {
          valign: center;
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Voltar à cor padrão");
          visible: false;

          styles [
            "flat",
          ]
        }

        [suffix]
        MenuButton fita_cor_app_menu {
          valign: center;
          tooltip-text: _("Escolher a cor da iluminação inteligente");

          child: DrawingArea fita_cor_app_amostra {
            content-width: 22;
            content-height: 22;
          };

          popover: Popover {
            child: ColorChooserWidget fita_cor_app_seletor {
              use-alpha: false;
            };
          };
        }
      }

      Adw.ActionRow fita_configurar_row {
        title: _("Configurar a iluminação inteligente");
        subtitle: _("Busca os dispositivos na sua conta da Tuya");
        activatable-widget: fita_configurar_button;

        [suffix]
        Button fita_configurar_button {
          valign: center;
          icon-name: "applications-engineering-symbolic";
          tooltip-text: _("Abrir assistente");

          styles [
            "flat"
          ]
        }
      }

      Adw.ActionRow fita_testar_row {
        title: _("Testar");
        subtitle: _("Acende cada dispositivo na cor do aplicativo");
        sensitive: bind session_fita_switch.active;
        activatable-widget: fita_testar_button;

        [suffix]
        Button fita_testar_button {
          valign: center;
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Ligar a iluminação inteligente");

          styles [
            "flat"
          ]
        }
      }
    }
  }

  Adw.PreferencesPage import_page {
    name: "import";
    title: _("Import");
    icon-name: "document-save-symbolic";

    Adw.PreferencesGroup import_behavior_group {
      title: _("Behavior");

      Adw.SwitchRow auto_import_switch {
        title: _("Import Games Automatically");
      }

      Adw.SwitchRow remove_missing_switch {
        title: _("Remove Uninstalled Games");
      }
    }

    Adw.PreferencesGroup sources_group {
      title: _("Sources");
      separate-rows: true;

      Adw.ExpanderRow steam_expander_row {
        title: _("Steam");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "steam-source-symbolic";
        }

        Adw.ActionRow steam_data_action_row {
          title: _("Install Location");

          Button steam_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow lutris_expander_row {
        title: _("Lutris");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "lutris-source-symbolic";
        }

        Adw.ActionRow lutris_data_action_row {
          title: _("Install Location");

          Button lutris_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }

        Adw.SwitchRow lutris_import_steam_switch {
          title: _("Import Steam Games");
        }

        Adw.SwitchRow lutris_import_flatpak_switch {
          title: _("Import Flatpak Games");
        }
      }

      Adw.ExpanderRow heroic_expander_row {
        title: _("Heroic");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "heroic-source-symbolic";
        }

        Adw.ActionRow heroic_config_action_row {
          title: _("Install Location");

          Button heroic_config_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }

        Adw.SwitchRow heroic_import_epic_switch {
          title: _("Import Epic Games");
        }

        Adw.SwitchRow heroic_import_gog_switch {
          title: _("Import GOG Games");
        }

        Adw.SwitchRow heroic_import_amazon_switch {
          title: _("Import Amazon Games");
        }

        Adw.SwitchRow heroic_import_sideload_switch {
          title: _("Import Sideloaded Games");
        }
      }

      Adw.ExpanderRow bottles_expander_row {
        title: _("Bottles");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "bottles-source-symbolic";
        }

        Adw.ActionRow bottles_data_action_row {
          title: _("Install Location");

          Button bottles_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow dolphin_expander_row {
        title: _("Dolphin");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "dolphin-source-symbolic";
        }

        Adw.ActionRow dolphin_cache_action_row {
          title: _("Cache Location");

          Button dolphin_cache_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow itch_expander_row {
        title: _("itch");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "itch-source-symbolic";
        }

        Adw.ActionRow itch_config_action_row {
          title: _("Install Location");

          Button itch_config_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow legendary_expander_row {
        title: _("Legendary");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "legendary-source-symbolic";
        }

        Adw.ActionRow legendary_config_action_row {
          title: _("Install Location");

          Button legendary_config_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow retroarch_expander_row {
        title: _("RetroArch");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "retroarch-source-symbolic";
        }

        Adw.ActionRow retroarch_config_action_row {
          title: _("Install Location");

          Button retroarch_config_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow waydroid_expander_row {
        title: _("Waydroid");
        subtitle: _("Android apps installed through Waydroid");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "waydroid-source-symbolic";
        }
      }

      Adw.ExpanderRow yuzu_expander_row {
        title: _("Yuzu");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "yuzu-source-symbolic";
        }

        Adw.ActionRow yuzu_data_action_row {
          title: _("Install Location");

          Button yuzu_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow twintail_expander_row {
        title: _("TwinTail");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "twintail-source-symbolic";
        }

        Adw.ActionRow twintail_data_action_row {
          title: _("Install Location");

          Button twintail_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }
      }

      Adw.ExpanderRow shortcuts_expander_row {
        title: _("Windows Shortcuts");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "application-x-executable-symbolic";
        }

        Adw.ActionRow shortcuts_location_action_row {
          title: _("Install Location");

          Button shortcuts_location_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }

        Adw.SwitchRow shortcuts_recursive_switch {
          title: _("Scan Subfolders");
          subtitle: _("Also import shortcuts from subfolders");
        }
      }

      Adw.ExpanderRow flatpak_expander_row {
        title: _("Flatpak");
        show-enable-switch: true;

        [prefix]
        Image {
          icon-name: "flatpak-source-symbolic";
        }

        Adw.ActionRow flatpak_system_data_action_row {
          // The location of the system-wide data directory
          title: _("System Location");

          Button flatpak_system_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }

        Adw.ActionRow flatpak_user_data_action_row {
          // The location of the user-specific data directory
          title: _("User Location");

          Button flatpak_user_data_file_chooser_button {
            icon-name: "folder-symbolic";
            valign: center;

            styles [
              "flat"
            ]
          }

          styles [
            "property"
          ]
        }

        Adw.SwitchRow flatpak_import_launchers_switch {
          title: _("Import Game Launchers");
        }
      }

      Adw.SwitchRow desktop_switch {
        title: _("Desktop Entries");

        [prefix]
        Image {
          icon-name: "user-desktop-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage sgdb_page {
    name: "sgdb";
    title: _("SteamGridDB");
    icon-name: "image-x-generic-symbolic";

    Adw.PreferencesGroup sgdb_key_group {
      title: _("Authentication");

      Adw.EntryRow sgdb_key_entry_row {
        title: _("API Key");
      }
    }

    Adw.PreferencesGroup sgdb_behavior_group {
      title: _("Behavior");

      Adw.SwitchRow sgdb_switch {
        title: _("Use SteamGridDB");
        subtitle: _("Download images when adding or importing games");
      }

      Adw.SwitchRow sgdb_prefer_switch {
        title: _("Prefer Over Official Images");
      }

      Adw.SwitchRow sgdb_animated_switch {
        title: _("Prefer Animated Images");
      }
    }

    Adw.PreferencesGroup {
      Adw.ActionRow {
        title: _("Update Covers");
        subtitle: _("Fetch covers for games already in your library");
        sensitive: bind sgdb_switch.active;

        Stack sgdb_stack {
          Button sgdb_fetch_button {
            label: _("Update");
            valign: center;
          }

          Adw.Spinner sgdb_spinner {
            visible: false;
            valign: center;
          }
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "thegamesdb";
    title: _("TheGamesDB");
    icon-name: "applications-games-symbolic";
    Adw.PreferencesGroup thegamesdb_key_group {
      title: _("Autenticação");

      Adw.EntryRow thegamesdb_key_entry_row {
        title: _("Chave da API");
      }
    }

    Adw.PreferencesGroup {
      title: _("Metadados e imagens");

      Adw.SwitchRow thegamesdb_switch {
        title: _("Usar TheGamesDB");
        subtitle: _("Completa detalhes e usa capas e fanarts como fallback");
      }
    }

    Adw.PreferencesGroup {
      Adw.ActionRow {
        title: _("Atualizar biblioteca");
        subtitle: _("Busca dados e imagens para os jogos já adicionados");
        sensitive: bind thegamesdb_switch.active;

        Stack thegamesdb_stack {
          Button thegamesdb_fetch_button {
            label: _("Atualizar");
            valign: center;
          }

          Adw.Spinner thegamesdb_spinner {
            visible: false;
            valign: center;
          }
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "igdb";
    title: _("IGDB");
    icon-name: "applications-games-symbolic";

    Adw.PreferencesGroup igdb_key_group {
      title: _("Autenticação");

      Adw.EntryRow igdb_client_id_entry_row {
        title: _("Client ID");
      }

      Adw.EntryRow igdb_client_secret_entry_row {
        title: _("Client Secret");
      }
    }

    Adw.PreferencesGroup {
      title: _("Capas e capturas");

      Adw.ActionRow {
        title: _("Onde conseguir as chaves");
        subtitle: _("Crie um app em api.igdb.com para obter o Client ID e o Secret");
      }
    }
  }
}
