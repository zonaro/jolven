using Gtk 4.0;
using Adw 1;

Adw.StatusPage notice_no_results {
  icon-name: "system-search-symbolic";
  title: _("No Games Found");
  description: _("Try a different search");
  vexpand: true;
  valign: center;
}

Adw.StatusPage hidden_notice_no_results {
  icon-name: "system-search-symbolic";
  title: _("No Games Found");
  description: _("Try a different search");
  vexpand: true;
  valign: center;
}

Adw.StatusPage notice_empty {
  title: _("No Games");
  description: _("Use the + button to add games");
  vexpand: true;
  valign: center;

  Button {
    label: _("Import");
    halign: center;
    action-name: "app.import";

    styles [
      "pill",
      "suggested-action",
    ]
  }
}

Adw.StatusPage hidden_notice_empty {
  icon-name: "view-conceal-symbolic";
  title: _("No Hidden Games");
  description: _("Games you hide will appear here");
  vexpand: true;
  valign: center;
}

Adw.StatusPage zerados_notice_no_results {
  icon-name: "system-search-symbolic";
  title: _("Nenhum jogo encontrado");
  description: _("Tente outro filtro.");
  vexpand: true;
  valign: center;
}

Adw.StatusPage zerados_notice_empty {
  icon-name: "trofeu-symbolic";
  title: _("Nenhum jogo zerado");
  description: _("Os jogos desinstalados marcados como Zerado são exibidos aqui.");
  vexpand: true;
  valign: center;
}

  template $CartridgesWindow: Adw.ApplicationWindow {
    title: _("Jolven");
  width-request: 360;
  height-request: 100;

  Adw.Breakpoint {
    condition ("max-width: 564px")

    setters {
      overlay_split_view.collapsed: true;
      details_view_box.orientation: vertical;
      details_view_box.margin-top: 12;
      details_view_box.margin-start: 12;
      details_view_box.margin-end: 12;
      details_view_details_box.margin-start: 0;
      details_view_details_box.margin-end: 0;
      details_view_title.margin-top: 30;
      details_view_title.halign: center;
      details_view_developer.halign: center;
      details_view_date_box.halign: center;
      details_view_toolbar.halign: center;
      details_view_toolbar.orientation: vertical;
      details_view_play_button.halign: center;
      details_view_toolbar_buttons.margin-start: 0;
    }
  }

  Adw.ToastOverlay toast_overlay {
    Overlay session_overlay {
      Adw.NavigationView navigation_view {
      Adw.NavigationPage game_mode_home_page {
        title: _("Jolven Session");

        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
            show-end-title-buttons: false;

            [end]
            Button {
              icon-name: "system-shutdown-symbolic";
              tooltip-text: _("Power menu");
              action-name: "app.power_menu";
            }
          }

          ScrolledWindow {
            hscrollbar-policy: never;

            Adw.Clamp {
              maximum-size: 900;
              tightening-threshold: 700;

              Box {
                orientation: vertical;
                spacing: 24;
                margin-top: 36;
                margin-bottom: 36;
                margin-start: 24;
                margin-end: 24;

                Adw.Avatar game_mode_avatar {
                  size: 96;
                  show-initials: true;
                  halign: center;
                }

                Label game_mode_welcome_label {
                  label: _("Welcome");
                  halign: center;

                  styles [
                    "title-1",
                  ]
                }

                Label {
                  label: _("What would you like to play?");
                  halign: center;

                  styles [
                    "dim-label",
                  ]
                }

                Button game_mode_continue_button {
                  label: _("Continue playing");
                  action-name: "app.continue_game";
                  height-request: 64;

                  styles [
                    "suggested-action",
                    "pill",
                  ]
                }

                Button game_mode_library_button {
                  label: _("Library");
                  action-name: "win.open_library";
                  height-request: 56;

                  styles [
                    "pill",
                  ]
                }

                Box {
                  homogeneous: true;
                  spacing: 12;

                  Button {
                    label: _("Settings");
                    action-name: "app.preferences";
                    height-request: 52;
                  }

                  Button {
                    label: _("Power");
                    action-name: "app.power_menu";
                    height-request: 52;
                  }
                }
              }
            }
          }
        }
      }

      Adw.NavigationPage library_page {
        title: _("Biblioteca");

        Adw.OverlaySplitView overlay_split_view {
          sidebar-width-fraction: .36;
          min-sidebar-width: 340;
          max-sidebar-width: 460;

          [sidebar]
          Adw.NavigationPage sidebar_navigation_page {
            title: _("Jolven");

            Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                Button {
                  icon-name: "sidebar-show-symbolic";
                  action-name: "win.show_sidebar";
                  tooltip-text: _("Toggle Sidebar");
                }

                [end]
                Adw.Spinner xcloud_refresh_spinner {
                  visible: false;
                  width-request: 16;
                  height-request: 16;
                }

                [end]
                Button xcloud_refresh_button {
                  icon-name: "view-refresh-symbolic";
                  tooltip-text: _("Atualizar catálogo Xbox Cloud");
                  visible: false;
                }
              }

              ScrolledWindow {
                hscrollbar-policy: never;

                ListBox sidebar {
                  selection-mode: none;

                  ListBoxRow {
                    selectable: false;
                    activatable: false;

                    Label {
                      label: _("Plataformas");

                      styles [
                        "heading",
                      ]

                      halign: start;
                    }
                  }

                  styles [
                    "navigation-sidebar",
                  ]
                }
              }
            }
          }

          Adw.ToolbarView library_view {
            [top]
            Adw.HeaderBar header_bar {
              [start]
              Button show_sidebar_button {
                icon-name: "sidebar-show-symbolic";
                action-name: "win.show_sidebar";
                tooltip-text: _("Toggle Sidebar");
                visible: bind overlay_split_view.show-sidebar inverted;
              }

              [start]
              MenuButton {
                tooltip-text: _("Add Game");
                icon-name: "list-add-symbolic";
                menu-model: add_games;
              }

              [end]
              MenuButton primary_menu_button {
                tooltip-text: _("Main Menu");
                icon-name: "open-menu-symbolic";
                menu-model: primary_menu;
              }

              [end]
              ToggleButton search_button {
                tooltip-text: _("Search");
                icon-name: "system-search-symbolic";
                action-name: "win.toggle_search";
              }

              [end]
              Button {
                tooltip-text: _("Jogos Zerados");
                icon-name: "trofeu-symbolic";
                action-name: "win.show_zerados";
              }

              [end]
              Button news_button {
                tooltip-text: _("Novidades");
                action-name: "win.show_news";

                styles [
                  "flat",
                  "image-button",
                ]

                Overlay {
                  Image {
                    icon-name: "novidades-symbolic";
                    pixel-size: 20;
                  }

                  [overlay]
                  Box news_badge {
                    visible: false;
                    can-target: false;
                    halign: end;
                    valign: start;

                    styles [
                      "news-badge",
                    ]
                  }
                }
              }
            }

            [top]
            SearchBar search_bar {
              search-mode-enabled: bind search_button.active bidirectional;
              key-capture-widget: navigation_view;

              Adw.Clamp {
                maximum-size: 500;
                tightening-threshold: 500;

                Box {
                  spacing: 6;

                  SearchEntry search_entry {
                    placeholder-text: _("Search");
                    hexpand: true;

                    ShortcutController {
                      Shortcut {
                        trigger: "Escape";
                        action: "action(win.toggle_search)";
                      }
                    }
                  }

                  Button game_mode_keyboard_button {
                    visible: false;
                    icon-name: "input-keyboard-symbolic";
                    tooltip-text: _("On-screen keyboard");
                  }
                }
              }
            }

            [top]
            Box launchers_bar {
              visible: true;
              halign: center;
              spacing: 6;
              margin-start: 15;
              margin-end: 15;
              margin-top: 10;

              Box launchers_box {
                spacing: 6;
              }

              Separator {
                orientation: vertical;
                margin-top: 6;
                margin-bottom: 6;
              }

              Button {
                icon-name: "input-gaming-symbolic";
                tooltip-text: _("Testar gamepad");
                action-name: "win.open_gamepad_test";
                width-request: 40;
                height-request: 40;

                styles [
                  "flat",
                  "circular",
                ]
              }
            }

            Overlay library_overlay {
              [overlay]
              ScrolledWindow scrolledwindow {
                $AnimatedFlowBox library {
                  homogeneous: true;
                  halign: center;
                  valign: start;
                  column-spacing: 12;
                  row-spacing: 12;
                  // Mantém a primeira fileira afastada dos launchers para
                  // revelar o wallpaper. Como a margem pertence ao conteúdo
                  // rolável, ela desaparece naturalmente durante a rolagem.
                  margin-top: 96;
                  margin-bottom: 15;
                  margin-start: 15;
                  margin-end: 15;
                  selection-mode: none;

                  styles [
                    "no-hover",
                  ]
                }
              }

              Stack library_background_stack {
                can-target: false;
                halign: fill;
                valign: fill;
                hexpand: true;
                vexpand: true;
                transition-type: crossfade;
                transition-duration: 400;

                Picture library_background_a {
                  can-target: false;
                  halign: fill;
                  valign: fill;
                  hexpand: true;
                  vexpand: true;
                  content-fit: cover;
                  keep-aspect-ratio: false;
                  opacity: 0.25;
                }

                Picture library_background_b {
                  can-target: false;
                  halign: fill;
                  valign: fill;
                  hexpand: true;
                  vexpand: true;
                  content-fit: cover;
                  keep-aspect-ratio: false;
                  opacity: 0.25;
                }
              }
            }
          }
        }
      }
     }

      [overlay]
      Box session_blocker {
        visible: false;
        halign: fill;
        valign: fill;
        hexpand: true;
        vexpand: true;

        styles [
          "session-blocker",
        ]

        Box {
          orientation: vertical;
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;
          spacing: 18;
          margin-start: 24;
          margin-end: 24;

          Label session_blocker_label {
            halign: center;
            wrap: true;
            wrap-mode: word_char;
            natural-wrap-mode: word;
            justify: center;

            styles [
              "title-1",
            ]
          }

          Label session_blocker_timer {
            visible: false;
            halign: center;

            styles [
              "title-1",
              "numeric",
            ]
          }

          Box {
            halign: center;
            spacing: 12;

            Button session_return_button {
              label: _("Voltar ao jogo");
              height-request: 52;

              styles [
                "suggested-action",
                "pill",
              ]
            }

            Button gpu_screen_recorder_button {
              icon-name: "media-record-symbolic";
              tooltip-text: _("Iniciar a gravação. Clique com o botão direito para salvar o replay.");
              width-request: 52;
              height-request: 52;

              accessibility {
                label: _("Iniciar ou parar a gravação");
              }

              styles [
                "circular",
              ]
            }
          }

          MenuButton session_blocker_notes_button {
            label: _("Onde eu parei");
            halign: center;
            tooltip-text: _("Anotar onde você parou neste jogo");

            styles [
              "flat",
            ]

            popover: Popover session_blocker_notes_popover {
              Box {
                orientation: vertical;
                width-request: 320;

                ScrolledWindow {
                  height-request: 120;
                  hscrollbar-policy: never;

                  TextView session_blocker_notes_view {
                    top-margin: 4;
                    bottom-margin: 4;
                    left-margin: 4;
                    right-margin: 4;
                    wrap-mode: word_char;
                  }
                }
              }
            };
          }

          Button session_blocker_button {
            label: _("Já terminei de jogar");
            halign: center;

            styles [
              "flat",
              "destructive-action",
            ]
          }
        }
      }
   }
  }
}

Adw.NavigationPage gamepad_test_page {
  title: _("Teste de gamepad");
  tag: "gamepad-test";

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    ScrolledWindow {
      hscrollbar-policy: never;

      Adw.Clamp {
        maximum-size: 760;
        tightening-threshold: 560;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 18;
        margin-end: 18;

        Box {
          orientation: vertical;
          spacing: 18;

          Label {
            label: _("Pressione os botões e mova os analógicos para conferir cada entrada. Para sair, pressione Menu e View juntos.");
            wrap: true;
            justify: center;
            styles ["title-3"]
          }

          Label gamepad_test_device_label {
            label: _("Nenhum gamepad conectado");
            wrap: true;
            justify: center;
            styles ["dim-label"]
          }

          Label gamepad_test_layout_label {
            label: _("Layout não identificado");
            wrap: true;
            justify: center;
            styles ["caption", "dim-label"]
          }

          Box gamepad_visual_slot {
            hexpand: true;
            styles ["gamepad-visual-slot"]
          }

          Label {
            label: _("A selecionar  •  B voltar  •  X menu do jogo  •  Y pesquisar  •  Menu menu principal  •  Guide barra lateral");
            wrap: true;
            justify: center;
            styles ["caption", "dim-label"]
          }

          Label gamepad_test_event_label {
            label: _("Aguardando entrada…");
            wrap: true;
            justify: center;
            styles ["heading"]
          }

          FlowBox gamepad_test_buttons {
            homogeneous: true;
            selection-mode: none;
            min-children-per-line: 3;
            max-children-per-line: 5;
            column-spacing: 8;
            row-spacing: 8;
          }

          Adw.PreferencesGroup {
            title: _("Eixos e gatilhos");

            Adw.ActionRow {
              title: _("Analógico esquerdo / eixo 0");
              [suffix]
              Label gamepad_test_axis_0 { label: "0.00"; styles ["numeric"] }
            }

            Adw.ActionRow {
              title: _("Analógico esquerdo / eixo 1");
              [suffix]
              Label gamepad_test_axis_1 { label: "0.00"; styles ["numeric"] }
            }

            Adw.ActionRow {
              title: _("LT / eixo 2");
              [suffix]
              Label gamepad_test_axis_2 { label: "0.00"; styles ["numeric"] }
            }

            Adw.ActionRow {
              title: _("Analógico direito / eixo 3");
              [suffix]
              Label gamepad_test_axis_3 { label: "0.00"; styles ["numeric"] }
            }

            Adw.ActionRow {
              title: _("Analógico direito / eixo 4");
              [suffix]
              Label gamepad_test_axis_4 { label: "0.00"; styles ["numeric"] }
            }

            Adw.ActionRow {
              title: _("RT / eixo 5");
              [suffix]
              Label gamepad_test_axis_5 { label: "0.00"; styles ["numeric"] }
            }
          }

          Label gamepad_test_hat_label {
            label: _("Direcional: centralizado");
            styles ["dim-label"]
          }
        }
      }
    }
  }
}

Adw.NavigationPage hidden_library_page {
  title: _("Hidden Games");

  Adw.ToolbarView hidden_library_view {
    [top]
    Adw.HeaderBar hidden_header_bar {
      [end]
      MenuButton hidden_primary_menu_button {
        tooltip-text: _("Main Menu");
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
      }

              [end]
              ToggleButton hidden_search_button {
                tooltip-text: _("Search");
                icon-name: "system-search-symbolic";
                action-name: "win.toggle_search";
              }

              [end]
              Button {
                tooltip-text: _("Jogos Zerados");
                icon-name: "trofeu-symbolic";
                action-name: "win.show_zerados";
              }
            }

    [top]
    SearchBar hidden_search_bar {
      search-mode-enabled: bind hidden_search_button.active bidirectional;
      key-capture-widget: hidden_library_view;

      Adw.Clamp {
        maximum-size: 500;
        tightening-threshold: 500;

        Box {
          spacing: 6;

          SearchEntry hidden_search_entry {
            placeholder-text: _("Search");
            hexpand: true;
          }

          Button hidden_game_mode_keyboard_button {
            visible: false;
            icon-name: "input-keyboard-symbolic";
            tooltip-text: _("On-screen keyboard");
          }
        }
      }
    }

    Overlay hidden_library_overlay {
      ScrolledWindow hidden_scrolledwindow {
        FlowBox hidden_library {
          homogeneous: true;
          halign: center;
          valign: start;
          column-spacing: 12;
          row-spacing: 12;
          margin-top: 15;
          margin-bottom: 15;
          margin-start: 15;
          margin-end: 15;
          selection-mode: none;

          styles [
            "no-hover",
          ]
        }
      }
    }

    styles [
      "background",
    ]
  }
}

Adw.NavigationPage zerados_library_page {
  title: _("Jogos Zerados");

  Adw.ToolbarView zerados_library_view {
    [top]
    Adw.HeaderBar zerados_header_bar {
      [start]
      Button zerados_add_button {
        tooltip-text: _("Adicionar a Jogos Zerados");
        icon-name: "list-add-symbolic";
        action-name: "win.add_zerado";
      }

      [end]
      MenuButton zerados_primary_menu_button {
        tooltip-text: _("Menu principal");
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
      }
    }

    Overlay zerados_library_overlay {
      ScrolledWindow zerados_scrolledwindow {
        $AnimatedFlowBox zerados_library {
          homogeneous: true;
          halign: center;
          valign: start;
          column-spacing: 12;
          row-spacing: 12;
          margin-top: 15;
          margin-bottom: 15;
          margin-start: 15;
          margin-end: 15;
          selection-mode: none;

          styles [
            "no-hover",
          ]
        }
      }
    }

    styles [
      "background",
    ]
  }
}

Adw.NavigationPage news_page {
  title: _("Novidades");
  Adw.ToolbarView news_view {
    [top]
    Adw.HeaderBar {
      [end]
      Button news_refresh_button {
        tooltip-text: _("Atualizar");
        icon-name: "view-refresh-symbolic";
      }
    }

    Stack news_stack {
      transition-type: crossfade;

      StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;
          width-request: 32;
          height-request: 32;
        };
      }

      StackPage {
        name: "list";

        child: ScrolledWindow news_scrolledwindow {
          hexpand: true;
          vexpand: true;

          Adw.Clamp {
            maximum-size: 800;
            tightening-threshold: 600;
            margin-top: 18;
            margin-bottom: 18;
            margin-start: 12;
            margin-end: 12;

            ListBox news_list {
              selection-mode: none;
              valign: start;

              styles [
                "boxed-list",
                "news-list",
              ]
            }
          }
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage news_status {
          icon-name: "novidades-symbolic";
          title: _("Sem novidades");
          description: _("Não foi possível carregar as novidades.");
          vexpand: true;
          valign: center;

          Button news_retry_button {
            label: _("Tentar novamente");
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          }
        };
      }
    }
  }
}

Adw.NavigationPage xcloud_player_page {
  title: _("Xbox Cloud Gaming");
  tag: "xcloud";

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar xcloud_header_bar {
      show-title: true;

      [start]
      Button xcloud_close_button {
        icon-name: "window-close-symbolic";
        tooltip-text: _("Fechar o Xbox Cloud Gaming");
        action-name: "win.close_xcloud";
      }

      [end]
      Button xcloud_menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Menu do player");
        action-name: "win.xcloud_player_menu";
      }

      [end]
      Button xcloud_fullscreen_button {
        icon-name: "view-fullscreen-symbolic";
        tooltip-text: _("Tela cheia");
        action-name: "win.toggle_xcloud_fullscreen";
      }
    }

    Overlay xcloud_box {
      hexpand: true;
      vexpand: true;

      Box xcloud_container {
        halign: fill;
        valign: fill;
        hexpand: true;
        vexpand: true;
        visible: false;
      }

      [overlay]
      Adw.Spinner xcloud_spinner {
        halign: center;
        valign: center;
        width-request: 32;
        height-request: 32;
      }

      [overlay]
      Adw.StatusPage xcloud_error {
        visible: false;
        icon-name: "network-error-symbolic";
        title: _("Xbox Cloud Gaming indisponível");
        description: _("Não foi possível iniciar a transmissão.");
        vexpand: true;
        valign: center;

        Button xcloud_retry_button {
          label: _("Tentar novamente");
          halign: center;

          styles [
            "pill",
            "suggested-action",
          ]
        }
      }
    }

    ShortcutController {
      Shortcut {
        trigger: "Escape";
        action: "action(win.xcloud_escape)";
      }
    }
  }
}

Adw.NavigationPage details_page {
  title: _("Game Details");

  Overlay details_view {
    name: "details_view";

    [overlay]
    Adw.ToolbarView details_view_toolbar_view {
      [top]
      Adw.HeaderBar {}

      ScrolledWindow {
        Box details_view_box {
          halign: center;
          valign: center;
          margin-start: 24;
          margin-end: 24;
          margin-top: 24;
          margin-bottom: 24;

          Adw.Clamp {
            maximum-size: 200;

            Overlay {
              [overlay]
              Adw.Spinner details_view_spinner {
                visible: false;
              }

              Picture details_view_cover {
                halign: end;
                valign: start;
                width-request: 200;
                height-request: 300;

                styles [
                  "card",
                ]
              }
            }
          }

          Box details_view_details_box {
            orientation: vertical;
            margin-start: 48;
            vexpand: true;
            valign: center;

            Label details_view_title {
              label: _("Game Title");
              hexpand: true;
              halign: start;
              max-width-chars: 24;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "title-1",
              ]
            }

            Label details_view_developer {
              margin-top: 6;
              hexpand: true;
              halign: start;
              max-width-chars: 36;
              wrap: true;
              wrap-mode: word_char;
              natural-wrap-mode: word;

              styles [
                "heading",
              ]
            }

            Box details_view_date_box {
              orientation: horizontal;
              margin-top: 15;
              hexpand: true;
              halign: start;

              Label details_view_added {
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              Label details_view_last_played {
                margin-start: 12;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              Label details_view_size {
                margin-start: 12;
                visible: false;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }

              Label details_view_playtime {
                margin-start: 12;
                visible: false;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                justify: center;
              }
            }

            Label details_view_metadata {
              margin-top: 12;
              hexpand: true;
              halign: start;
              xalign: 0;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              visible: false;

              styles [
                "dim-label",
              ]
            }

            Label details_view_description {
              margin-top: 15;
              hexpand: true;
              halign: start;
              xalign: 0;
              max-width-chars: 72;
              wrap: true;
              wrap-mode: word_char;
              visible: false;
            }

            Box details_view_screenshots_group {
              orientation: vertical;
              margin-top: 18;
              hexpand: true;
              visible: false;

              Label {
                label: _("Capturas de tela");
                halign: start;

                styles [
                  "heading",
                ]
              }

              ScrolledWindow {
                margin-top: 8;
                height-request: 150;
                vscrollbar-policy: never;

                Box details_view_screenshots {
                  spacing: 9;
                }
              }
            }

            Box details_view_status_box {
              orientation: horizontal;
              margin-top: 12;
              halign: start;
              spacing: 6;

              MenuButton details_view_status_button {
                tooltip-text: _("Status deste jogo na biblioteca");

                styles [
                  "flat",
                ]
              }

              MenuButton details_view_notes_button {
                visible: false;
                label: _("Onde eu parei");
                tooltip-text: _("Anotar onde você parou neste jogo");

                styles [
                  "flat",
                ]

                popover: Popover details_view_notes_popover {
                  Box {
                    orientation: vertical;
                    width-request: 320;

                    ScrolledWindow {
                      height-request: 120;
                      hscrollbar-policy: never;

                      TextView details_view_notes_view {
                        top-margin: 4;
                        bottom-margin: 4;
                        left-margin: 4;
                        right-margin: 4;
                        wrap-mode: word_char;
                      }
                    }
                  }
                };
              }
            }

            Box details_view_notes_box {
              orientation: vertical;
              margin-top: 18;
              hexpand: true;
              halign: start;
              visible: false;

              Label {
                halign: start;
                xalign: 0;
                label: _("Onde eu parei");

                styles [
                  "caption-heading",
                  "dim-label",
                ]
              }

              Label details_view_notes {
                margin-top: 3;
                hexpand: true;
                halign: start;
                xalign: 0;
                max-width-chars: 72;
                wrap: true;
                wrap-mode: word_char;
                natural-wrap-mode: word;
                lines: 3;
                ellipsize: end;

                styles [
                  "dim-label",
                ]
              }
            }

            Button details_view_update_notice {
              margin-top: 15;
              halign: start;
              visible: false;
              tooltip-text: _("Abrir a página da atualização");

              Box {
                spacing: 8;
                halign: center;

                Image {
                  icon-name: "software-update-available-symbolic";
                }

                Label {
                  label: _("Atualização disponível");

                  styles [
                    "heading",
                  ]
                }
              }
            }

            Box details_view_toolbar {
              hexpand: true;
              vexpand: true;
              valign: center;

              Box {
                halign: start;
                margin-top: 24;
                spacing: 6;

                Button details_view_play_button {
                  name: "details_view_play_button";
                  action-name: "app.launch_game";
                  label: _("Play");
                  halign: start;

                  styles [
                    "opaque",
                    "pill",
                  ]
                }

                MenuButton details_view_play_menu_button {
                  icon-name: "pan-down-symbolic";
                  halign: start;
                  valign: center;
                  visible: false;
                  tooltip-text: _("Jogar via…");

                  styles [
                    "raised",
                    "circular",
                  ]
                }
              }

              Box details_view_toolbar_buttons {
                halign: start;
                valign: center;
                margin-top: 24;
                margin-start: 9;

                Button {
                  icon-name: "document-edit-symbolic";
                  action-name: "app.edit_game";
                  tooltip-text: _("Edit");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                Button details_view_hide_button {
                  action-name: "app.hide_game";

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                Button {
                  icon-name: "user-trash-symbolic";
                  action-name: "app.remove_game";
                  tooltip-text: _("Remove");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                Button details_view_delete_button {
                  icon-name: "user-trash-symbolic";
                  action-name: "win.delete_game";
                  tooltip-text: _("Excluir");
                  visible: false;

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                MenuButton {
                  icon-name: "system-search-symbolic";
                  menu-model: search;
                  tooltip-text: _("Search");

                  styles [
                    "raised",
                    "circular",
                  ]
                }

                styles [
                  "toolbar",
                ]
              }
            }
          }
        }
      }
    }

    Picture details_view_blurred_cover {
      keep-aspect-ratio: false;
    }
  }
}

menu primary_menu {
  section {
    submenu {
      label: _("Sort");

      item {
        label: _("A-Z");
        action: "win.sort_by";
        target: "a-z";
      }

      item {
        label: _("Z-A");
        action: "win.sort_by";
        target: "z-a";
      }

      item {
        label: _("Newest");
        action: "win.sort_by";
        target: "newest";
      }

      item {
        label: _("Oldest");
        action: "win.sort_by";
        target: "oldest";
      }

      item {
        label: _("Last Played");
        action: "win.sort_by";
        target: "last_played";
      }

      item {
        label: _("Tamanho");
        action: "win.sort_by";
        target: "install_size";
      }
    }

    item {
      label: _("Show Hidden");
      action: "win.show_hidden";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
        label: _("Install Jolven Session");
      action: "app.install_game_mode";
      hidden-when: "action-disabled";
    }

    item {
        label: _("Uninstall Jolven Session");
      action: "app.uninstall_game_mode";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Session Menu");
      action: "app.power_menu";
      hidden-when: "action-disabled";
    }

    item (_("Preferences"), "app.preferences")
    item (_("Integrações"), "app.integrations")
    item (_("Sunshine"), "app.sunshine")
    item (_("Keyboard Shortcuts"), "app.shortcuts")
        item (_("About Jolven"), "app.about")
  }
}

menu add_games {
  section {
    item (_("Add Game"), "app.add_game")
  }

  section {
    item (_("Import"), "app.import")
  }
}

menu search {
  section {
    label: _("Search on…");
    item (_("IGDB"), "app.igdb_search")
    item (_("SteamGridDB"), "app.sgdb_search")
    item (_("ProtonDB"), "app.protondb_search")
    item (_("PCGamingWiki"), "app.pcgw_search")
    item (_("Lutris"), "app.lutris_search")
    item (_("HowLongToBeat"), "app.hltb_search")
  }
}
