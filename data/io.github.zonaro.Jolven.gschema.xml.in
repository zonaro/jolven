<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cartridges">

  <schema id="@APP_ID@" path="@PREFIX@/">
    <key name="auto-import" type="b">
        <default>false</default>
    </key>
    <key name="exit-after-launch" type="b">
      <default>false</default>
    </key>
    <key name="cover-launches-game" type="b">
      <default>false</default>
    </key>
    <key name="high-quality-images" type="b">
      <default>false</default>
    </key>
    <key name="remove-missing" type="b">
      <default>true</default>
    </key>
    <key name="playtime-tracking" type="b">
      <default>true</default>
    </key>
    <key name="language" type="s">
      <default>"auto"</default>
    </key>
    <key name="process-tracking-grace" type="i">
      <default>5</default>
    </key>
    <key name="steam" type="b">
      <default>true</default>
    </key>
    <key name="steam-location" type="s">
      <default>"~/.steam/steam"</default>
    </key>
    <key name="steam-show-uninstalled" type="b">
      <default>false</default>
    </key>
    <key name="lutris" type="b">
      <default>true</default>
    </key>
    <key name="lutris-location" type="s">
      <default>"~/.var/app/net.lutris.Lutris/data/lutris/"</default>
    </key>
    <key name="lutris-cache-location" type="s">
      <default>"~/.var/app/net.lutris.Lutris/cache/lutris"</default>
    </key>
    <key name="lutris-import-steam" type="b">
      <default>false</default>
    </key>
    <key name="lutris-import-flatpak" type="b">
      <default>false</default>
    </key>
    <key name="lutris-show-uninstalled" type="b">
      <default>false</default>
    </key>
    <key name="heroic" type="b">
      <default>true</default>
    </key>
    <key name="heroic-location" type="s">
      <default>"~/.config/heroic/"</default>
    </key>
    <key name="heroic-import-epic" type="b">
      <default>true</default>
    </key>
    <key name="heroic-import-gog" type="b">
      <default>true</default>
    </key>
    <key name="heroic-import-amazon" type="b">
      <default>true</default>
    </key>
    <key name="heroic-import-sideload" type="b">
      <default>true</default>
    </key>
    <key name="heroic-show-uninstalled" type="b">
      <default>false</default>
    </key>
    <key name="bottles" type="b">
      <default>true</default>
    </key>
    <key name="bottles-location" type="s">
      <default>"~/.var/app/com.usebottles.bottles/data/bottles/"</default>
    </key>
    <key name="dolphin" type="b">
      <default>true</default>
    </key>
    <key name="dolphin-cache-location" type="s">
      <default>"~/.var/app/org.DolphinEmu.dolphin-emu/cache/dolphin-emu/"</default>
    </key>
    <key name="itch" type="b">
      <default>true</default>
    </key>
    <key name="itch-location" type="s">
      <default>"~/.var/app/io.itch.itch/config/itch/"</default>
    </key>
    <key name="legendary" type="b">
      <default>true</default>
    </key>
    <key name="legendary-location" type="s">
      <default>"~/.config/legendary/"</default>
    </key>
    <key name="legendary-show-uninstalled" type="b">
      <default>false</default>
    </key>
    <key name="retroarch" type="b">
      <default>true</default>
    </key>
    <key name="retroarch-location" type="s">
      <default>"~/.var/app/org.libretro.RetroArch/config/retroarch/"</default>
    </key>
    <key name="waydroid" type="b">
      <default>true</default>
    </key>
    <key name="yuzu" type="b">
      <default>true</default>
    </key>
    <key name="yuzu-location" type="s">
      <default>"~/.var/app/org.yuzu_emu.yuzu/config/yuzu/"</default>
    </key>
    <key name="quiver" type="b">
      <default>true</default>
    </key>
    <key name="quiver-location" type="s">
      <default>"~/.local/share/QuiverLauncher"</default>
    </key>
    <key name="quiver-show-uninstalled" type="b">
      <default>false</default>
    </key>
    <key name="quiver-enrich" type="b">
      <default>true</default>
    </key>
    <key name="twintail" type="b">
      <default>true</default>
    </key>
    <key name="twintail-location" type="s">
      <default>"~/.local/share/twintaillauncher"</default>
    </key>
    <key name="desktop" type="b">
      <default>true</default>
    </key>
    <key name="flatpak" type="b">
      <default>true</default>
    </key>
    <key name="flatpak-system-location" type="s">
      <default>"/var/lib/flatpak/"</default>
    </key>
    <key name="flatpak-user-location" type="s">
      <default>"~/.local/share/flatpak/"</default>
    </key>
    <key name="flatpak-import-launchers" type="b">
      <default>false</default>
    </key>
    <key name="sgdb-key" type="s">
      <default>""</default>
    </key>
    <key name="sgdb" type="b">
      <default>false</default>
    </key>
    <key name="sgdb-prefer" type="b">
      <default>false</default>
    </key>
    <key name="sgdb-animated" type="b">
      <default>false</default>
    </key>
    <key name="thegamesdb-key" type="s">
      <default>""</default>
    </key>
    <key name="thegamesdb" type="b">
      <default>false</default>
    </key>
    <key name="igdb-client-id" type="s">
      <default>""</default>
    </key>
    <key name="igdb-client-secret" type="s">
      <default>""</default>
    </key>
    <key name="wallhaven-key" type="s">
      <default>""</default>
    </key>
    <key name="wallhaven-categorias" type="s">
      <default>"100"</default>
    </key>
    <key name="wallhaven-pureza" type="s">
      <default>"100"</default>
    </key>
    <key name="wallhaven-ordenacao" type="s">
      <default>"relevance"</default>
    </key>
    <key name="wallhaven-ordem" type="s">
      <default>"desc"</default>
    </key>
    <key name="wallhaven-alcance" type="s">
      <default>"1M"</default>
    </key>
    <key name="wallhaven-cores" type="s">
      <default>""</default>
    </key>
    <key name="library-rows" type="u">
      <default>0</default>
    </key>
    <key name="updates-check-interval" type="i">
      <default>12</default>
    </key>
    <key name="news-check-interval" type="i">
      <default>6</default>
    </key>
    <key name="show-news-button" type="b">
      <default>false</default>
    </key>
    <key name="shortcuts" type="b">
      <default>true</default>
      <summary>Import Windows Start Menu and desktop shortcuts</summary>
    </key>
    <key name="shortcuts-location" type="s">
      <default>""</default>
      <summary>Windows shortcuts scan location</summary>
    </key>
    <key name="shortcuts-recursive" type="b">
      <default>false</default>
      <summary>Scan Windows shortcuts subfolders recursively</summary>
    </key>
    <key name="session-wallpaper" type="b">
      <default>false</default>
    </key>
    <key name="session-wallpaper-saved" type="s">
      <default>""</default>
    </key>
    <key name="fita-brilho-padrao" type="i">
      <default>180</default>
    </key>
    <key name="fita-matiz-app" type="i">
      <default>284</default>
    </key>
    <key name="fita-saturacao-app" type="i">
      <default>620</default>
    </key>
    <key name="session-fita" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-use-gamemode" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-use-mangohud" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-enable-fps-limiter" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-enable-vrr" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-start-library" type="b">
      <default>false</default>
    </key>
    <key name="game-mode-hide-mouse-cursor" type="b">
      <default>true</default>
    </key>
    <key name="game-overlay-button" type="s">
      <choices>
        <choice value="mode" />
        <choice value="home" />
        <choice value="both" />
      </choices>
      <default>"both"</default>
      <summary>Controller button used to open the in-game overlay</summary>
    </key>
    <key name="game-mode-monitor" type="s">
      <default>""</default>
    </key>
    <key name="game-mode-audio-output" type="s">
      <default>""</default>
    </key>
    <key name="game-mode-audio-input" type="s">
      <default>""</default>
    </key>
    <key name="fita-estado-anterior" type="s">
      <default>""</default>
    </key>
    <key name="agrupar-duplicados" type="b">
      <default>true</default>
    </key>
    <key name="xbox-cloud-gaming" type="b">
      <default>false</default>
    </key>
    <key name="xcloud-fullscreen-on-start" type="b">
      <default>false</default>
    </key>
    <key name="sunshine-auto-sync" type="b">
      <default>false</default>
      <summary>Automatically add games to Sunshine</summary>
      <description>When enabled, new and edited games are exported to the Sunshine apps.json file, except Xbox Cloud Gaming titles.</description>
    </key>
    <key name="sunshine-apps-path" type="s">
      <default>""</default>
      <summary>Sunshine apps.json location</summary>
      <description>Custom path to the Sunshine apps.json file. Empty means the default ~/.config/sunshine/apps.json.</description>
    </key>
    <key name="sunshine-host" type="s">
      <default>"localhost"</default>
      <summary>Sunshine Web UI host</summary>
      <description>Host of the local Sunshine Web UI used for status and app listing.</description>
    </key>
    <key name="sunshine-port" type="i">
      <default>47990</default>
      <summary>Sunshine Web UI port</summary>
      <description>HTTPS port of the local Sunshine Web UI.</description>
    </key>
    <key name="sunshine-username" type="s">
      <default>""</default>
      <summary>Sunshine Web UI username</summary>
      <description>Username created in the Sunshine Web UI. The password is kept in the user's keyring (Secret Service).</description>
    </key>
    <key name="disabled-source-filters" type="as">
      <default>[]</default>
    </key>
    <key name="app-icon" type="s">
      <choices>
        <choice value="jolven-dpad" />
        <choice value="jolven-portal" />
      </choices>
      <default>"jolven-dpad"</default>
    </key>
    <key name="theme-slug" type="s">
      <choices>
        <choice value="adwaita" />
        <choice value="adwaita-gray" />
        <choice value="breeze" />
        <choice value="canta" />
        <choice value="catppuccin-frappe" />
        <choice value="catppuccin-latte" />
        <choice value="catppuccin-macchiato" />
        <choice value="catppuccin-mocha" />
        <choice value="dracula" />
        <choice value="everforest" />
        <choice value="gruvbox" />
        <choice value="kate" />
        <choice value="metro" />
        <choice value="nord" />
        <choice value="oled" />
        <choice value="one-dark" />
        <choice value="pop" />
        <choice value="rose-pine" />
        <choice value="tokyo-night" />
        <choice value="tomorrow-night" />
        <choice value="vapor" />
        <choice value="vgui2" />
        <choice value="yaru" />
        <choice value="jolven" />
      </choices>
      <default>"jolven"</default>
      <summary>Application theme selection</summary>
    </key>
    <key name="theme-mode" type="s">
      <choices>
        <choice value="light" />
        <choice value="dark" />
        <choice value="auto" />
      </choices>
      <default>"auto"</default>
      <summary>Colour scheme mode</summary>
    </key>
    <key name="theme-accent-custom" type="s">
      <default>""</default>
      <summary>Custom accent colour in #RRGGBB format (empty = theme default)</summary>
    </key>
    <key name="steam-skin-enabled" type="b">
      <default>false</default>
      <summary>Apply the selected theme as a skin to Steam</summary>
    </key>
    <key name="steam-install-path" type="s">
      <default>""</default>
      <summary>Custom Steam installation path (empty = auto-detect)</summary>
    </key>
    <key name="recorder-enabled" type="b">
      <default>false</default>
      <summary>Enable the Jolven screen recorder</summary>
      <description>Enables the recorder controls backed by gpu-screen-recorder in the Jolven session.</description>
    </key>
    <key name="recorder-source" type="s">
      <default>"portal"</default>
      <summary>Video capture source</summary>
      <description>How the recorder captures the screen: the desktop portal, a monitor or a window.</description>
    </key>
    <key name="recorder-container" type="s">
      <default>"mp4"</default>
      <summary>Output container format</summary>
      <description>Container used for the recorded video files.</description>
    </key>
    <key name="recorder-codec" type="s">
      <default>"auto"</default>
      <summary>Video codec</summary>
      <description>Video encoder used for recording. Auto selects the best available hardware encoder.</description>
    </key>
    <key name="recorder-quality" type="s">
      <default>"very_high"</default>
      <summary>Recording quality preset</summary>
      <description>Quality preset applied when the bitrate mode is set to auto.</description>
    </key>
    <key name="recorder-bitrate-mode" type="s">
      <default>"auto"</default>
      <summary>Bitrate control mode</summary>
      <description>Whether the recorder picks the bitrate automatically or uses constant/variable bitrate.</description>
    </key>
    <key name="recorder-fps" type="i">
      <default>60</default>
      <summary>Recording frame rate</summary>
      <description>Frames per second captured by the recorder.</description>
    </key>
    <key name="recorder-cursor" type="b">
      <default>true</default>
      <summary>Record the mouse cursor</summary>
      <description>Whether the mouse cursor is included in the recorded video.</description>
    </key>
    <key name="recorder-scale" type="s">
      <default>""</default>
      <summary>Output resolution</summary>
      <description>Optional output resolution such as 1920x1080. Empty keeps the source resolution.</description>
    </key>
    <key name="recorder-audio" type="s">
      <default>"default_output"</default>
      <summary>Audio source</summary>
      <description>Audio captured by the recorder: default output, output and microphone or none.</description>
    </key>
    <key name="recorder-audio-codec" type="s">
      <default>"opus"</default>
      <summary>Audio codec</summary>
      <description>Audio encoder used for recording.</description>
    </key>
    <key name="recorder-audio-bitrate" type="i">
      <default>128</default>
      <summary>Audio bitrate</summary>
      <description>Audio bitrate in kbps used for recording.</description>
    </key>
    <key name="recorder-replay-seconds" type="i">
      <default>0</default>
      <summary>Replay buffer length</summary>
      <description>Seconds kept in the replay buffer. Zero disables the replay buffer.</description>
    </key>
    <key name="recorder-replay-storage" type="s">
      <default>"ram"</default>
      <summary>Replay buffer storage</summary>
      <description>Whether the replay buffer is kept in RAM or on disk.</description>
    </key>
    <key name="recorder-output-dir" type="s">
      <default>"~/Videos/Jolven"</default>
      <summary>Recording output directory</summary>
      <description>Directory where recordings and saved replays are written.</description>
    </key>
    <key name="recorder-stream-url" type="s">
      <default>""</default>
      <summary>Streaming URL</summary>
      <description>RTMP, SRT or WHIP destination used when streaming. The URL is never logged.</description>
    </key>
  </schema>

  <schema id="@APP_ID@.State" path="@PREFIX@/State/">
    <key name="width" type="i">
      <default>1170</default>
    </key>
    <key name="height" type="i">
      <default>795</default>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
    </key>
    <key name="sort-mode" type="s">
      <choices>
        <choice value="a-z" />
        <choice value="z-a" />
        <choice value="newest" />
        <choice value="oldest" />
        <choice value="last_played" />
        <choice value="install_size" />
      </choices>
      <default>"last_played"</default>
    </key>
    <key name="show-sidebar" type="b">
      <default>false</default>
    </key>
    <key name="steam-limiter-tokens-history" type="s">
      <default>"[]"</default>
    </key>
    <key name="news-last-seen-ts" type="x">
      <default>0</default>
    </key>
  </schema>
</schemalist>
