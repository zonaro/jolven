import gettext
import locale
import os
import signal
import sys
from pathlib import Path

VERSION = "@VERSION@"


def _detect_prefix() -> "str | None":
    """Devolve o prefix de instalacao deduzido do caminho deste script.

    Permite relocalizar a instalacao dentro de um AppImage e reutilizar
    os mesmos recursos do Jolven sem depender do prefixo da compilacao. Devolve None
    quando a arvore relocada nao e encontrada (fallback: paths de build).
    """
    try:
        script_dir = Path(__file__).resolve().parent  # $prefix/bin
        prefix = script_dir.parent
        if (prefix / "share" / "jolven" / "jolven.gresource").exists():
            return str(prefix)
        # Compat: arvore legada do Cartridges no mesmo prefix
        if (prefix / "share" / "cartridges" / "cartridges.gresource").exists():
            return str(prefix)
    except OSError:
        pass
    return None


def _detect_python_dir(prefix: str) -> "str | None":
    """Localiza o site-packages do app dentro do prefix detectado."""
    base = Path(prefix)
    candidates = (
        sorted(base.glob("lib/python3*/site-packages"))
        + sorted(base.glob("lib64/python3*/site-packages"))
        + sorted(base.glob("lib/python3*/dist-packages"))
        + sorted(base.glob("lib64/python3*/dist-packages"))
    )
    for candidate in candidates:
        if (candidate / "cartridges" / "shared.py").exists():
            return str(candidate)
    return None


_DETECTED_PREFIX = _detect_prefix()
if _DETECTED_PREFIX is None:
    PKGDATADIR = "@pkgdatadir@"
    PYTHONDIR = "@pythondir@"
    LOCALEDIR = "@localedir@"
else:
    _candidate = os.path.join(_DETECTED_PREFIX, "share", "jolven")
    _legacy = os.path.join(_DETECTED_PREFIX, "share", "cartridges")
    PKGDATADIR = (
        _candidate
        if os.path.exists(os.path.join(_candidate, "jolven.gresource"))
        else _legacy
    )
    PYTHONDIR = _detect_python_dir(_DETECTED_PREFIX) or "@pythondir@"
    LOCALEDIR = os.path.join(_DETECTED_PREFIX, "share", "locale")

# Keep the executable, Python package and resource bundle from the same Meson
# installation.  Python normally puts the per-user site-packages directory
# ahead of /usr or /usr/local, which can otherwise combine newer Python code
# with an older Gtk resource bundle and make the window template fail to load.
sys.path.insert(0, PYTHONDIR)
signal.signal(signal.SIGINT, signal.SIG_DFL)

# Dominio gettext historico: os catalogos em po/ ainda geram
# cartridges.mo; renomear o dominio esvaziaria as 30 traducoes.
#
# Idioma das Preferências ("language"): "auto" respeita o locale do sistema;
# outro código força o catálogo via LANGUAGE, que o gettext consulta antes de
# LC_MESSAGES. Precisa rodar antes do install para valer na sessão inteira.
def _preferred_language() -> "str | None":
    try:
        from gi.repository import Gio  # noqa: PLC0415

        lang = Gio.Settings.new("@APP_ID@").get_string("language")
        if lang and lang != "auto":
            return lang
    except Exception:  # schema ausente: segue o locale do sistema
        pass
    return None


_preferred_language = _preferred_language()
if _preferred_language is not None:
    os.environ["LANGUAGE"] = _preferred_language

locale.bindtextdomain("cartridges", LOCALEDIR)
locale.textdomain("cartridges")
gettext.install("cartridges", LOCALEDIR, names=['ngettext'])

if __name__ == "__main__":
    from gi.repository import Gio, GLib

    try:
        resource = Gio.Resource.load(os.path.join(PKGDATADIR, "jolven.gresource"))
    except GLib.GError:
        # Compat: bundle legado do Cartridges
        resource = Gio.Resource.load(
            os.path.join(PKGDATADIR, "cartridges.gresource")
        )
    resource._register()  # pylint: disable=protected-access

    from cartridges import main

    sys.exit(main.main(VERSION))
