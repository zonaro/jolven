from enum import IntEnum, auto
from os import getenv
from pathlib import Path

from gi.repository import Gdk, Gio, GLib

from cartridges.runtime import RuntimeContext
from cartridges import platform
from cartridges.platform import paths as _platform_paths


class AppState(IntEnum):
    DEFAULT = auto()
    LOAD_FROM_DISK = auto()
    IMPORT = auto()
    REMOVE_ALL_GAMES = auto()
    UNDO_REMOVE_ALL_GAMES = auto()


APP_ID = "@APP_ID@"
_SETUP_VERSION = "@VERSION@"
# Versão exibida no app (Fixes #6): gerada pela data de compilação no formato
# YY.DDD.HHMM (ano 2 dígitos, dia do ano, hora+minuto 24h). `version.py` é
# regenerado a cada `meson compile` via custom_target e tem precedência sobre
# o valor congelado no `meson setup`. Fallback valida o setup e, em árvore
# sem build (ex: testes a partir do fonte), usa a data atual para nunca
# exibir "@VERSION@".
VERSION = _SETUP_VERSION
try:
    from cartridges.version import BUILD_VERSION as _BUILD_VERSION

    import re as _re

    if isinstance(_BUILD_VERSION, str) and _re.match(
        r"^\d{2}\.\d{3}\.\d{4}$", _BUILD_VERSION.strip()
    ):
        VERSION = _BUILD_VERSION.strip()
except Exception:
    pass
if not isinstance(VERSION, str) or VERSION.startswith("@"):
    try:
        from datetime import datetime as _dt

        VERSION = _dt.now().strftime("%y.%j.%H%M")
    except Exception:
        VERSION = _SETUP_VERSION
# Raiz do GResource (ex: /page/redclaw/Cartridges), e NÃO caminho de disco:
# Gtk.Template(resource_path=...) e new_from_resource() exigem o caminho do
# recurso registrado, que independe de onde a árvore foi instalada. Apontar
# o PREFIX para um prefixo de disco quebrava todo template (o app nem abria
# após `ninja install`).
PREFIX = "@PREFIX@"
PROFILE = "@PROFILE@"
TIFF_COMPRESSION = "@TIFF_COMPRESSION@"
# Action polkit da Jolven Session (fonte canônica do id; o texto também vive
# em cartridges/platform/system_integration.py para as camadas sem gi).
GAME_MODE_ACTION_ID = "io.github.zonaro.Jolven.configure-game-mode"

GAME_SESSION_FILE = Path("@game_session_datadir@") / "wayland-sessions" / "io.github.zonaro.Jolven.GameMode.desktop"
# Sessao legada (Cartridges) — mantida como fallback de leitura/deteccao.
LEGACY_GAME_SESSION_FILE = Path("@game_session_datadir@") / "wayland-sessions" / "page.redclaw.Cartridges.GameMode.desktop"
SPEC_VERSION = 1.5  # The version of the game_id.json spec


def _migrate_legacy_dir(new: "Path", legacy: "Path") -> None:
    """Copia dados legados do Cartridges para o diretorio do Jolven.

    Copia apenas o que ainda nao existe no destino e NUNCA apaga a origem,
    para que o usuario nao perca biblioteca, capas, configuracoes,
    favoritos ou metadados. Operacao idempotente e silenciosa em caso de
    erro (o app precisa abrir mesmo sem migracao).
    """
    try:
        if not legacy.is_dir():
            return
        if new.is_dir() and any(new.iterdir()):
            return
        import shutil

        new.parent.mkdir(parents=True, exist_ok=True)
        if new.exists():
            for item in legacy.iterdir():
                target = new / item.name
                if target.exists():
                    continue
                if item.is_dir():
                    shutil.copytree(item, target, symlinks=True)
                else:
                    shutil.copy2(item, target)
        else:
            shutil.copytree(legacy, new, symlinks=True)
    except OSError:
        pass


LEGACY_APP_IDS = ("page.redclaw.Cartridges", "page.redclaw.Cartridges.Devel")


def _migrate_gsettings(settings: "Gio.Settings") -> None:
    """Copia chaves do schema legado para o novo schema quando vazio.

    So preenche chaves que ainda estao no valor padrao, preservando
    qualquer personalizacao ja feita no Jolven.
    """
    try:
        legacy_source = Gio.SettingsSchemaSource.get_default()
        if legacy_source is None:
            return
        for legacy_id in LEGACY_APP_IDS:
            legacy_schema = legacy_source.lookup(legacy_id, True)
            if legacy_schema is None:
                continue
            legacy = Gio.Settings.new_full(legacy_schema, None, None)
            for key in legacy_schema.list_keys():
                try:
                    if settings.get_value(key) != settings.get_default_value(key):
                        continue
                    settings.set_value(key, legacy.get_value(key))
                except (TypeError, AttributeError):
                    continue
            break
    except Exception:  # pylint: disable=broad-exception-caught
        pass

schema = Gio.Settings.new(APP_ID)
state_schema = Gio.Settings.new(APP_ID + ".State")
_migrate_gsettings(schema)
runtime = RuntimeContext()

home = Path.home()

# No Windows, os caminhos passam pela camada de plataforma porque
# GLib.get_user_cache_dir() resolve para INetCache, que a Limpeza de
# Disco/Storage Sense esvazia por padrao — exatamente onde estaria o log
# de um crash. Os host_* sao caminhos do host Flatpak (HOST_XDG_*); no
# Windows nao ha Flatpak, entao espelham os diretorios locais.
if platform.IS_WINDOWS:
    data_dir = _platform_paths.base_data_dir()
    config_dir = _platform_paths.base_config_dir()
    cache_dir = _platform_paths.base_cache_dir()
    host_data_dir = data_dir
    host_config_dir = config_dir
    host_cache_dir = cache_dir
else:
    data_dir = Path(GLib.get_user_data_dir())
    host_data_dir = Path(getenv("HOST_XDG_DATA_HOME", Path.home() / ".local" / "share"))
    config_dir = Path(GLib.get_user_config_dir())
    host_config_dir = Path(getenv("HOST_XDG_CONFIG_HOME", Path.home() / ".config"))
    cache_dir = Path(GLib.get_user_cache_dir())
    host_cache_dir = Path(getenv("HOST_XDG_CACHE_HOME", Path.home() / ".cache"))

flatpak_dir = home / ".var" / "app"

# Diretorios do Jolven; dados do fork anterior (Cartridges) sao migrados
# por copia na primeira execucao (origem preservada).
_migrate_legacy_dir(data_dir / "jolven", data_dir / "cartridges")
_migrate_legacy_dir(cache_dir / "jolven", cache_dir / "cartridges")

app_dir = data_dir / "jolven"

games_dir = data_dir / "jolven" / "games"
covers_dir = data_dir / "jolven" / "covers"
logos_dir = data_dir / "jolven" / "logos"
wallpapers_dir = data_dir / "jolven" / "wallpapers"
fitas_dir = data_dir / "jolven" / "fitas"
fitas_arquivo = data_dir / "jolven" / "fitas.json"
iluminacao_dir = data_dir / "jolven" / "iluminacao"

# Caminhos legados (leitura/compatibilidade apenas).
legacy_app_dir = data_dir / "cartridges"
legacy_games_dir = data_dir / "cartridges" / "games"
legacy_covers_dir = data_dir / "cartridges" / "covers"

appdata_dir = Path(getenv("appdata") or r"C:\Users\Default\AppData\Roaming")
local_appdata_dir = Path(
    getenv("localappdata") or r"C:\Users\Default\AppData\Local"
)
# Intencionalmente o Program Files de 32 bits: e onde o Steam instala no Windows de 64 bits.
programfiles32_dir = Path(getenv("programfiles(x86)") or r"C:\Program Files (x86)")

app_support_dir = home / "Library" / "Application Support"

try:
    scale_factor = max(
        monitor.get_scale_factor()
        for monitor in Gdk.Display.get_default().get_monitors()
    )
except AttributeError:  # If shared.py is imported by the search provider
    pass
else:
    image_size = (200 * scale_factor, 300 * scale_factor)

# pylint: disable=invalid-name
win = None
importer = None
import_time = None
store = None
log_files = []
