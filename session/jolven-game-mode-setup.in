#!/usr/bin/bash
# X-Jolven-Managed=true
# Privileged helper invoked by pkexec. It accepts only the fixed operations below.
set -euo pipefail

readonly action="${1:-}"
readonly session_file="@game_session_datadir@/wayland-sessions/io.github.zonaro.Jolven.GameMode.desktop"
# Resolve the session launcher from the user who invoked this helper.
# This helper runs as root via pkexec (typically from /usr/libexec), so the
# launcher must NOT be derived from $0: dirname($0)/../bin would point at
# /usr/bin even when Jolven was installed per-user under $HOME/.local/bin.
# Only the fixed candidate list below is considered; no path is ever accepted
# from arguments or the environment.
resolve_session_launcher() {
    local invoking_uid="${PKEXEC_UID:-}" invoking_home=""
    if [[ -n "$invoking_uid" ]]; then
        # Do not trust $HOME: pkexec clears the environment. Look up the
        # invoking user's home directory in the system database instead.
        invoking_home="$(getent passwd "$invoking_uid" 2>/dev/null | cut -d: -f6 || true)"
        if [[ -z "$invoking_home" && -r /etc/passwd ]]; then
            invoking_home="$(awk -F: -v uid="$invoking_uid" '$3 == uid { print $6; exit }' /etc/passwd || true)"
        fi
        if [[ -n "$invoking_home" && -x "$invoking_home/.local/bin/jolven-session" ]]; then
            printf '%s\n' "$invoking_home/.local/bin/jolven-session"
            return 0
        fi
    fi
    # System-wide candidates. Also used when PKEXEC_UID is unset (helper run
    # directly as root instead of through pkexec): per-user resolution is
    # impossible then, so only system locations are considered.
    local candidate
    for candidate in /usr/local/bin/jolven-session /usr/bin/jolven-session; do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

if session_launcher="$(resolve_session_launcher)"; then
    readonly session_launcher
else
    readonly session_launcher=""
fi

. /etc/os-release
distro_name="${NAME:-Linux}"
distro_name="${distro_name% Linux}"
distro_name="${distro_name//$'\n'/ }"

if [[ "$action" == name ]]; then
    printf 'Jolven Session\n'
    exit 0
fi

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    printf 'This helper must be run through pkexec or sudo.\n' >&2
    exit 77
fi
if [[ "$action" != install && "$action" != uninstall ]]; then
    printf 'Usage: jolven-game-mode-setup install|uninstall|name\n' >&2
    exit 64
fi

is_managed() {
    # Aceita tanto o marcador atual quanto o legado (Cartridges).
    [[ -f "$session_file" ]] && grep -Eq '^X-(Jolven|Cartridges)-Managed=true$' "$session_file"
}

if [[ "$action" == uninstall ]]; then
    if is_managed; then
        rm -- "$session_file"
        printf 'Jolven Session removed.\n'
    elif [[ -e "$session_file" ]]; then
        printf 'Refusing to remove an unmanaged session file: %s\n' "$session_file" >&2
        exit 73
    else
        printf 'Jolven Session is not installed.\n'
    fi
    exit 0
fi

if [[ -z "$session_launcher" || ! -x "$session_launcher" ]]; then
    printf 'Session launcher not found. The Jolven installation looks incomplete: none of the expected session launchers exist.\n' >&2
    exit 69
fi

if [[ "${ID:-}" == fedora ]]; then
    missing=()
    for package in gamescope gamemode libmanette desktop-file-utils polkit wireplumber; do
        rpm -q "$package" >/dev/null 2>&1 || missing+=("$package")
    done
    if (( ${#missing[@]} )); then
        dnf install --refresh --assumeyes "${missing[@]}"
    fi
elif ! command -v gamescope >/dev/null 2>&1; then
    printf 'Install Gamescope with your distribution package manager first.\n' >&2
    exit 69
fi

install -d -m 0755 -- "$(dirname -- "$session_file")"
if [[ -e "$session_file" ]] && ! is_managed; then
    backup="$session_file.backup.$(date +%Y%m%d%H%M%S)"
    cp --preserve=mode,timestamps -- "$session_file" "$backup"
    printf 'Existing unmanaged session preserved as %s\n' "$backup"
fi

temporary="$(mktemp "${session_file}.tmp.XXXXXX.desktop")"
trap 'rm -f -- "$temporary"' EXIT
printf '%s\n' \
    '[Desktop Entry]' \
    'Name=Jolven Session' \
    'Comment=Console-style gaming session powered by Jolven' \
    "Exec=$session_launcher" \
    "TryExec=$session_launcher" \
    'Type=Application' \
    'X-GDM-SessionRegisters=true' \
    'X-Jolven-Managed=true' > "$temporary"
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$temporary"
fi
chmod 0644 "$temporary"
mv -- "$temporary" "$session_file"
trap - EXIT
printf 'Jolven Session installed.\n'
